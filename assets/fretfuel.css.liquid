:root{--ink:#0b0b0c;--paper:#f4f1ea;--yellow:#e6c200;--muted:#716e67;--line:#dad7d0;--display:'Barlow Condensed','Arial Narrow',Impact,sans-serif;--body:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:94px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:14px;line-height:1.55}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button{color:inherit}button:disabled{cursor:not-allowed;opacity:.45}a{color:inherit;text-decoration:none}button{border:0;background:none;padding:0}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #a88d00;outline-offset:5px}button,a{touch-action:manipulation}h1,h2,h3,p{margin:0}h1,h2,h3{line-height:1.1}img{max-width:100%}[hidden]{display:none!important}.svg-library{position:absolute;width:0;height:0;overflow:hidden}.icon{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.small{width:14px;height:14px}.wrap{width:min(1328px,calc(100% - 112px));margin-inline:auto}.eyebrow{font-size:10px;font-weight:700;letter-spacing:1.8px;line-height:1.5;margin-bottom:12px}.eyebrow.light{color:#d5d1c8}.section{padding-block:76px}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:30px}.section-heading h2,.workbench-intro h2{font-size:36px;font-weight:550;letter-spacing:-1.3px}.text-link{display:inline-flex;align-items:center;gap:15px;font-size:12px;font-weight:600;border-bottom:1px solid currentColor;padding-bottom:5px;line-height:1.8}.text-link .icon{width:17px;height:17px}.text-link:hover{color:#8c7600}.text-link.light{color:var(--paper)}.text-link.light:hover{color:var(--yellow)}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;padding:17px 23px;min-height:53px;font-size:12px;font-weight:700;transition:background .2s,transform .2s}.button:hover{transform:translateY(-2px)}.button.yellow{background:var(--yellow);color:var(--ink)}.button.yellow:hover{background:#f4d417}.button.dark{background:var(--ink);color:var(--paper)}.button.outline{border:1px solid var(--line);justify-content:center}.button .icon{width:18px;height:18px}.icon-button{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center}.announcement{height:32px;display:flex;justify-content:space-between;align-items:center;background:#171717;color:#d3cfc7;padding-inline:56px;font-size:8px;letter-spacing:1.5px;font-weight:600;border-bottom:1px solid #31312f}.preview-label{color:#aaa69e;font-size:8px;letter-spacing:1px}.site-header{height:82px;padding:0 56px;background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:40px;position:sticky;top:0;z-index:20;border-bottom:1px solid #33322e}.brand{display:block;position:relative;width:193px;height:34px;overflow:hidden;flex-shrink:0}.brand img{position:absolute;width:201px;max-width:none;height:auto;left:-4px;top:-58px}.desktop-nav{display:flex;gap:33px;align-items:center;margin-left:auto;margin-right:auto}.desktop-nav a,.desktop-nav button{font-size:12px;color:#e9e5dd;display:flex;align-items:center;gap:7px}.desktop-nav a:hover,.desktop-nav button:hover{color:var(--yellow)}.header-actions{display:flex;align-items:center;gap:8px}.bag-button{width:auto;gap:8px}.bag-button span{font-size:10px;background:#33332f;width:18px;height:18px;display:grid;place-items:center;border-radius:50%}.mobile-menu{display:none}.mobile-nav{background:var(--ink);color:var(--paper);padding:20px;position:sticky;top:72px;z-index:19;border-bottom:1px solid #444}.mobile-nav button,.mobile-nav a{display:block;text-align:left;padding:12px;width:100%}.hero{min-height:586px;position:relative;background:var(--ink);color:var(--paper);overflow:hidden;display:flex;align-items:center}.hero-image{position:absolute;inset:0;backgr