/* A shopping-first layout on the original FretFuel visual direction. */
html{scroll-padding-top:142px}
.announcement{height:27px;font-size:7px;letter-spacing:1.2px}
.announcement>div{display:flex;align-items:center;gap:27px}
.announcement button{font-size:8px;color:#c9c5bc}
.shop-header{position:sticky;top:0;z-index:20;background:var(--ink);color:var(--paper)}
.site-header{position:static;height:84px;gap:42px;border-bottom:0}
.header-actions{gap:21px}
.header-help{display:flex;align-items:center;gap:9px;white-space:nowrap;font-size:11px}
.header-help .icon{width:21px}
.header-search{position:relative;display:flex;align-items:center;background:#f8f6f1;color:#171715;height:42px;flex:1;max-width:660px;min-width:220px;border:1px solid #f8f6f1}
.header-search select{max-width:125px;width:125px;background:transparent;padding:0 10px;border:0;border-right:1px solid #d8d5cd;height:22px;font-size:10px;outline-offset:5px}
.header-search input{min-width:0;flex:1;width:100%;background:none;border:0;padding:0 15px;height:100%;font-size:12px;outline-offset:-3px;color:#161614}
.header-search input::placeholder{color:#858178}
.header-search>button{display:grid;place-items:center;align-self:stretch;width:45px;background:var(--yellow);color:#111}
.header-search>button:hover{background:#f2d222}
.department-nav{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #282825;border-bottom:1px solid #34342f;height:44px;padding:0 56px;gap:24px}
.department-scroll{display:flex;align-items:center;gap:29px;height:100%;min-width:0}
.department-nav button,.department-nav a{white-space:nowrap;font-size:11px;color:#dedbd4;display:flex;align-items:center;gap:9px;height:100%;font-weight:500}
.department-nav button:hover,.department-nav a:hover{color:var(--yellow)}
.department-nav button:first-child{color:var(--yellow);padding-right:24px;border-right:1px solid #35352f}
.department-nav .icon{width:16px;height:16px}
.department-nav .nav-guide{font-size:10px;color:#aaa69b}
.mega-menu{position:absolute;top:100%;left:0;right:0;background:var(--paper);color:var(--ink);padding:20px 56px 0;box-shadow:0 18px 30px #0003;border-bottom:3px solid var(--yellow);max-height:calc(100dvh - 140px);overflow-y:auto}
.mega-heading{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:1.6px;font-weight:700;border-bottom:1px solid var(--line);padding-bottom:13px}
.mega-heading button{width:32px;height:32px}
.mega-categories{display:grid;grid-template-columns:repeat(6,1fr);gap:22px;padding:24px 0 30px}
.mega-category .mega-title{font-size:13px;font-weight:700;line-height:1.45;margin-bottom:5px;color:#171714}
.mega-category p{font-size:10px;line-height:1.5;color:#858075;margin-bottom:19px}
.mega-category button{display:block;font-size:12px;text-align:left;margin-bottom:13px;color:#48453e}
.mega-category button:hover{color:#977900;text-decoration:underline;text-underline-offset:4px}
.mega-footer{display:flex;gap:24px;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding:17px 0;font-size:10px;color:#777267}
.mega-footer button{display:flex;align-items:center;gap:13px;font-size:11px;color:#191915}
.mega-footer .icon{width:16px}
.header-suggestions{position:absolute;top:calc(100% + 10px);left:-1px;right:-1px;background:var(--paper);color:var(--ink);box-shadow:0 12px 28px #0003;border:1px solid #dad7cd;z-index:25;max-height:65dvh;overflow:auto}
.suggestion-heading{font-size:8px;letter-spacing:1.4px;color:#777267;padding:17px 18px 12px;font-weight:700}
.header-result{display:flex;width:100%;align-items:center;gap:12px;text-align:left;padding:10px 18px;border-top:1px solid #e1ddd4}
.header-result:hover{background:#eae5dc}
.header-result .part-image{width:58px;height:58px;flex-shrink:0}
.header-result>span{flex:1}
.header-result strong{display:block;font-size:11px;line-height:1.45;font-weight:600}
.header-result small{display:block;font-size:9px;color:#7d776a;margin-top:4px}
.header-result>b{font-size:11px;font-weight:500}
.search-all{display:flex;justify-content:space-between;align-items:center;width:100%;border-top:1px solid #d4cfc3;padding:14px 18px;font-size:11px;font-weight:600;background:#e8e1d4}
.search-all .icon{width:17px}
.search-empty{padding:5px 18px 22px;color:#726d63;font-size:12px;line-height:1.7}
.hero{min-height:320px}
.hero-image{background-position:center,center 61%;background-image:linear-gradient(90deg,rgba(11,11,12,.98) 0%,rgba(11,11,12,.78) 30%,rgba(11,11,12,.02) 75%),url("{{ 'ff-hero.png' | asset_url }}")}
.hero-copy{padding:30px 0 34px}
.hero .eyebrow{font-size:8px;letter-spacing:1.7px;margin-bottom:16px}
.hero h1{font-size:62px;letter-spacing:-.6px;line-height:.95}
.hero-description{font-size:12px;line-height:1.7;margin:17px 0 20px}
.hero-ctas{gap:25px}
.hero-ctas .button{min-height:43px;padding:12px 21px;font-size:11px;gap:45px}
.hero-ctas .text-link{font-size:10px}
.hero-caption{position:absolute;right:56px;bottom:28px;z-index:2;display:grid;gap:5px;text-align:right}
.hero-caption span{font-size:7px;letter-spacing:2px;color:#aaa69d}
.hero-caption strong{font-size:12px;letter-spacing:.2px;font-weight:400}
.hero:after{height:70px}
.section{padding-block:43px}
.section-heading{margin-bottom:24px;gap:20px}
.section-heading h2,.workbench-intro h2{font-size:29px;letter-spacing:-.8px}
.eyebrow{font-size:8px;letter-spacing:1.6px;margin-bottom:9px}
.categories{padding-top:25px;padding-bottom:27px}
.categories .section-heading{margin-bottom:16px}
.categories h2{font-size:22px;letter-spacing:-.45px}
.categories .text-link{font-size:10px}
.category-grid{grid-template-columns:repeat(9,minmax(0,1fr));gap:16px}
.category-image{aspect-ratio:1.35}
.category-image .part-image{height:100%;aspect-ratio:auto;background-size:300% 200%}
.category-image .part-image.extra{background-size:300% 100%}
.category-card h3{font-size:11px;line-height:1.4;font-weight:550;margin-top:10px;text-align:center}
.category-card:hover .category-image{transform:translateY(-3px)}
.featured-section{background:#eeebe4;padding-top:31px;padding-bottom:32px;border-top:1px solid #e5e1d7}
.product-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:22px}
.product-tabs{gap:23px;font-size:11px}
.product-tabs button{font-size:11px}
.product-tabs .section-shop-link{display:flex;align-items:center;gap:9px;margin-left:10px}
.product-tabs .section-shop-link .icon{width:17px}
.product-meta{font-size:8px;margin-top:14px;gap:4px}
.compare-button{font-size:9px}
.product-name{font-size:13px;line-height:1.45;min-height:38px;margin-top:8px;font-weight:600}
.product-spec{font-size:10px;line-height:1.5;margin-top:5px;min-height:16px}
.product-price{font-size:16px;font-weight:650}
.product-price small{font-size:8px}
.product-finish{font-size:9px}
.product-bottom{margin-top:12px;gap:5px;align-items:baseline}
.product-cta{display:flex;align-items:center;justify-content:space-between;width:100%;padding:9px 0 3px;margin-top:11px;border-top:1px solid #d6d0c5;font-size:10px;font-weight:550}
.product-cta .icon{width:16px;height:16px}
.product-cta:hover{color:#917600}
.product-image-button .quick-view{width:28px;height:28px;right:10px;bottom:10px}
.series-tag{font-size:7px;top:10px;left:10px;padding:4px 6px}
.sample-note{font-size:9px;margin-top:22px}
.selection-strip{display:flex;align-items:center;justify-content:space-between;gap:23px;padding-block:24px;border-bottom:1px solid var(--line)}
.selection-strip>div{display:flex;align-items:center;gap:13px}
.selection-icon{width:42px;height:42px;display:grid;place-items:center;border:1px solid #d6d0c4;flex-shrink:0}
.selection-strip .eyebrow{font-size:7px;letter-spacing:1.2px;margin-bottom:6px}
.selection-strip h2{font-size:16px;font-weight:500;letter-spacing:-.2px}
.selection-strip ol{list-style:none;display:flex;gap:25px;padding:0;margin:0}
.selection-strip li{font-size:10px;color:#746e62;white-space:nowrap}
.selection-strip li b{display:block;color:#9a8a53;font-weight:500;font-size:10px;letter-spacing:1px;margin-bottom:4px}
.selection-strip .text-link{font-size:10px;white-space:nowrap}
.components-section .product-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
.components-section .product-card{display:grid;grid-template-columns:104px 1fr;column-gap:16px;align-content:start}
.components-section .product-image-button{grid-row:1/6;align-self:start}
.components-section .product-meta{margin-top:1px;font-size:7px;flex-wrap:wrap}
.components-section .compare-button{font-size:8px}
.components-section .series-tag{display:none}
.components-section .product-name{min-height:0;margin-top:7px;font-size:12px}
.components-section .product-spec{min-height:0;font-size:9px}
.components-section .product-bottom{margin-top:9px;flex-wrap:wrap}
.components-section .product-price{font-size:14px}
.components-section .product-finish{font-size:8px}
.components-section .product-cta{grid-column:2}
.range-section{padding-top:10px;padding-bottom:42px}
.range-section .heading-description{font-size:11px}
.range-card{min-height:175px;padding:21px 24px}
.range-card h3{font-size:44px;margin-top:13px;margin-bottom:10px}
.range-card.x-range h3{font-size:37px}
.range-number{font-size:7px}
.range-card p{font-size:10px;line-height:1.6;max-width:none}
.range-link{font-size:10px;margin-top:20px}
.range-section .sample-note{font-size:8px}
.original-section{grid-template-columns:1fr 1fr;min-height:0}
.original-photo{min-height:280px;background-size:cover;background-position:72% 60%}
.original-copy{padding:32px 50px}
.original-copy h2{font-size:43px;margin-bottom:17px;line-height:1.02}
.original-copy h2 br{display:none}
.original-copy h2 br:after{content:' '}
.original-copy h2 em{display:block}
.original-copy p:not(.eyebrow){font-size:11px;max-width:480px;line-height:1.85;margin-bottom:12px}
.original-copy .text-link{font-size:10px;margin-top:3px}
.original-photo>span{font-size:8px}
.workbench-section{padding-block:44px}
.workbench-layout{gap:40px}
.workbench-intro>p:not(.eyebrow){font-size:11px;line-height:1.8;margin-top:14px}
.workbench-intro .text-link{font-size:10px}
.measurement-art,.finishes-art{height:154px}
.guide-card h3{font-size:15px;line-height:1.4}
.guide-type{font-size:7px;margin-top:18px}
.closing-strip{padding-block:29px}
.closing-strip h2{font-size:33px}
.closing-strip h2 br{display:none}
.closing-strip .button{min-height:46px;font-size:11px}
.catalog-view .product-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
.catalog-view{padding-top:25px}
.catalog-view h1{font-size:38px}
.site-footer{padding-top:42px}
.footer-main{padding-bottom:38px}
.footer-brand p{font-size:15px}
.footer-launch p{font-size:22px}
.footer-launch .footer-catalog-description{font-size:11px;font-weight:400;letter-spacing:0;line-height:1.75;color:#bcb7ab;margin-top:12px}
.range-card .range-link{margin-top:auto;padding-top:16px}
.footer-main h3{margin-bottom:17px}
.footer-bottom{padding-block:18px}
@media(min-width:1600px){.hero{min-height:370px}.hero-copy{padding-block:36px 42px}.hero h1{font-size:74px}}
@media(max-width:1200px){
 .site-header{gap:25px;padding-inline:32px}.header-actions{gap:15px}.header-help span{display:none}.header-search{max-width:none}
 .announcement{padding-inline:32px}.department-nav{padding-inline:32px;gap:10px}.department-scroll{gap:21px}.department-nav button{font-size:10px}.department-nav .nav-guide{display:none}
