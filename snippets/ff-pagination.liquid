{% if paginate.pages > 1 %}<nav class="ff-pagination" aria-label="Pagination">
  {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}
  {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}
  {% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}
</nav>{% endif %}
