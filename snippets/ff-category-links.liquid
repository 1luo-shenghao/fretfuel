{% assign all_parts_url = routes.all_products_collection_url %}
{% assign ff_tuners = collections['tuners'].url | default: all_parts_url %}
{% assign ff_bridges = collections['bridges'].url | default: all_parts_url %}
{% assign ff_pickups = collections['pickups'].url | default: all_parts_url %}
{% assign ff_electronics = collections['electronics'].url | default: all_parts_url %}
{% assign ff_pickguards = collections['pickguards'].url | default: all_parts_url %}
{% assign ff_hardware = collections['hardware'].url | default: all_parts_url %}
{% if mega %}
  <div class="mega-category"><a class="mega-title" href="{{ ff_tuners }}">Tuners ↗</a><p>Guitar, bass & classical</p><a href="{{ collections['guitar-tuners'].url | default: ff_tuners }}">Guitar tuners</a><a href="{{ collections['bass-tuners'].url | default: ff_tuners }}">Bass tuners</a></div>
  <div class="mega-category"><a class="mega-title" href="{{ ff_bridges }}">Bridges & tailpieces ↗</a><p>Fixed, tremolo & vibrato</p><a href="{{ collections['tremolo-bridges'].url | default: ff_bridges }}">Tremolo bridges</a><a href="{{ collections['tailpieces'].url | default: ff_bridges }}">Tailpieces</a></div>
  <div class="mega-category"><a class="mega-title" href="{{ ff_pickups }}">Pickups ↗</a><p>Single coil, humbucker & more</p><a href="{{ ff_pickups }}">Shop pickups</a></div>
  <div class="mega-category"><a class="mega-title" href="{{ ff_electronics }}">Electronics ↗</a><p>Pots, switches & jacks</p><a href="{{ ff_electronics }}">Shop electronics</a></div>
  <div class="mega-category"><a class="mega-title" href="{{ ff_pickguards }}">Pickguards ↗</a><p>Shapes, cutouts & finishes</p><a href="{{ ff_pickguards }}">Shop pickguards</a></div>
  <div class="mega-category"><a class="mega-title" href="{{ ff_hardware }}">Hardware & small parts ↗</a><p>Knobs, saddles & screws</p><a href="{{ collections['saddles'].url | default: ff_hardware }}">Saddles</a><a href="{{ collections['knobs'].url | default: ff_hardware }}">Control knobs</a></div>
{% else %}
  <a href="{{ ff_tuners }}">Tuners</a><a href="{{ ff_bridges }}">Bridges & tailpieces</a><a href="{{ ff_pickups }}">Pickups</a><a href="{{ ff_electronics }}">Electronics</a><a href="{{ ff_pickguards }}">Pickguards</a><a href="{{ ff_hardware }}">Hardware & small parts</a>
{% endif %}
