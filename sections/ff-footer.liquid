{% assign all_parts_url = routes.all_products_collection_url %}
{% assign guide_url = section.settings.guide_url %}
{% if guide_url == blank %}{% assign guide_url = routes.root_url | append: '#workbench' %}{% endif %}
<footer class="site-footer"><div class="wrap footer-main">
  <div class="footer-brand"><a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home"><img src="{{ 'ff-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1210" height="960"></a><p>Guitar & bass<br>replacement parts.</p></div>
  <div><h3>SHOP PARTS</h3>{% if section.settings.shop_menu != blank %}{% for link in section.settings.shop_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ all_parts_url }}">All replacement parts</a>{% render 'ff-category-links' %}{% endif %}</div>
  <div><h3>HELP & INFORMATION</h3>{% if section.settings.info_menu != blank %}{% for link in section.settings.info_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ guide_url }}">Part selection guide</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Your bag</a>{% endif %}</div>
  <div class="footer-launch"><h3>FRETFUEL</h3><p>{{ section.settings.tagline | escape }}</p><a class="text-link light" href="{{ all_parts_url }}">Browse parts <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
</div><div class="wrap footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ section.settings.footer_note | escape }}</span></div></footer>
{% schema %}
{"name":"FretFuel footer","settings":[{"type":"link_list","id":"shop_menu","label":"Shop menu"},{"type":"link_list","id":"info_menu","label":"Information menu"},{"type":"url","id":"guide_url","label":"Parts guide page"},{"type":"text","id":"tagline","label":"Tagline","default":"Keep the feel. Find your part."},{"type":"text","id":"footer_note","label":"Footer note","default":"Compare fit and dimensions before ordering."}]}
{% endschema %}
