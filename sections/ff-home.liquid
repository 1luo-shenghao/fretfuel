{% assign all_parts_url = routes.all_products_collection_url %}
{% assign guide_url = section.settings.guide_url %}
{% if guide_url == blank %}{% assign guide_url = routes.root_url | append: '#workbench' %}{% endif %}
{% assign featured_collection = section.settings.featured_collection | default: collections['all'] %}
{% assign components_collection = section.settings.components_collection | default: collections['all'] %}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-image" role="img" aria-label="Guitar bridge, pickups and controls"{% if section.settings.hero_image != blank %} style="background-image:linear-gradient(90deg,rgba(11,11,12,.98),rgba(11,11,12,.15)),url('{{ section.settings.hero_image | image_url: width: 2400 }}')"{% endif %}></div>
  <div class="hero-copy"><p class="eyebrow light"><span class="yellow-line"></span>{{ section.settings.eyebrow | escape }}</p><h1 id="hero-title">{{ section.settings.hero_line_1 | escape }}<br><span>{{ section.settings.hero_line_2 | escape }}</span></h1><p class="hero-description">{{ section.settings.hero_description | escape | newline_to_br }}</p><div class="hero-ctas"><a class="button yellow" href="{{ all_parts_url }}">Shop all parts <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a><a class="text-link light" href="{{ guide_url }}">Part selection guide ↗</a></div></div>
</section>
<section class="section wrap categories" id="categories"><div class="section-heading"><h2>Shop by part.</h2><a class="text-link" href="{{ all_parts_url }}">Browse all categories <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><div class="category-grid">
  {% for block in section.blocks %}{% if block.type == 'category' %}
    {% assign category_url = block.settings.collection.url | default: all_parts_url %}
    <a class="category-card" href="{{ category_url }}" {{ block.shopify_attributes }}><div class="category-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 350, 500', alt: block.settings.title }}{% else %}{% render 'ff-atlas-image', index: block.settings.atlas_index, label: block.settings.title %}{% endif %}</div><h3>{{ block.settings.title | escape }}</h3></a>
  {% endif %}{% endfor %}
</div></section>
<section class="section featured-section" id="featured"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">GUITAR & BASS PARTS</p><h2>{{ section.settings.featured_title | escape }}</h2></div><a class="text-link" href="{{ featured_collection.url | default: all_parts_url }}">View all <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><div class="product-grid">
  {% for product in featured_collection.products limit: 5 %}{% render 'ff-product-card', product: product %}{% else %}<p class="ff-no-products">Add products to your store to show featured parts here.</p>{% endfor %}
</div></div></section>
<section class="selection-strip wrap" aria-label="Choosing replacement parts"><div><span class="selection-icon"><svg class="icon" aria-hidden="true"><use href="#i-ruler"/></svg></span><div><p class="eyebrow">BEFORE YOU ADD TO YOUR BAG</p><h2>Check more than the outline.</h2></div></div><ol><li><b>01</b> Compare the shape</li><li><b>02</b> Check the dimensions</li><li><b>03</b> Compare mounting points</li></ol><a class="text-link" href="{{ guide_url }}">Open the parts guide <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></section>
<section class="section wrap components-section" id="components"><div class="section-heading"><div><p class="eyebrow">REPLACEMENT COMPONENTS</p><h2>{{ section.settings.components_title | escape }}</h2></div><a class="text-link" href="{{ components_collection.url | default: all_parts_url }}">Browse all parts <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><div class="product-grid">
  {% if section.settings.components_collection == blank %}{% for product in components_collection.products limit: 4 offset: 5 %}{% render 'ff-product-card', product: product %}{% else %}<p class="ff-no-products">More parts are coming soon.</p>{% endfor %}{% else %}{% for product in components_collection.products limit: 4 %}{% render 'ff-product-card', product: product %}{% else %}<p class="ff-no-products">Add products to this collection to show components here.</p>{% endfor %}{% endif %}
</div></section>
<section class="section wrap range-section" id="range"><div class="section-heading"><div><p class="eyebrow">FRETFUEL PRODUCT SERIES</p><h2>Browse by series.</h2></div><p class="heading-description">Compare the specifications of individual parts<br>within each series.</p></div><div class="range-grid">
  <a class="range-card hero-range" href="{{ section.settings.hero_collection.url | default: all_parts_url }}"><span class="range-number">01 / ENTRY</span><h3>Hero</h3><span class="range-link">Explore Hero <svg class="icon"><use href="#i-arrow"/></svg></span></a>
  <a class="range-card stage-range" href="{{ section.settings.stage_collection.url | default: all_parts_url }}"><span class="range-number">02 / MID-RANGE</span><h3>Stage</h3><span class="range-link">Explore Stage <svg class="icon"><use href="#i-arrow"/></svg></span></a>
  <a class="range-card black-range" href="{{ section.settings.black_collection.url | default: all_parts_url }}"><span class="range-number">03 / PREMIUM</span><h3>BLACK</h3><span class="range-link">Explore BLACK <svg class="icon"><use href="#i-arrow"/></svg></span></a>
  <a class="range-card x-range" href="{{ section.settings.black_x_collection.url | default: all_parts_url }}"><span class="range-number">04 / FLAGSHIP</span><h3>BLACK <b>X</b></h3><span class="range-link">Explore BLACK X <svg class="icon"><use href="#i-arrow"/></svg></span></a>
</div></section>
<section class="original-section" id="story"><div class="original-photo" role="img" aria-label="Guitar bridge, strings and controls"><span>BRIDGE, STRINGS & CONTROLS</span></div><div class="original-copy"><p class="eyebrow light">ABOUT FRETFUEL</p><h2>Replacement parts for <em>guitars & basses.</em></h2><p>FretFuel is a guitar and bass parts brand covering tuners, bridges, pickups, controls and hardware.</p><p>Compare a replacement with the part already on your instrument: its shape, dimensions, mounting method and electrical specifications where relevant.</p><a href="#range" class="text-link light">Browse product series <svg class="icon"><use href="#i-arrow"/></svg></a></div></section>
<section class="section workbench-section" id="workbench"><div class="wrap workbench-layout"><div class="workbench-intro"><p class="eyebrow">PART SELECTION GUIDES</p><h2>Choosing replacement parts.</h2><p>Check mounting positions, dimensions and electrical specifications before choosing a replacement.</p><a class="text-link" href="{{ guide_url }}">Replacement checklist <svg class="icon"><use href="#i-arrow"/></svg></a></div><a class="guide-card" href="{{ guide_url }}"><div class="measurement-art"><svg viewBox="0 0 340 180" role="img" aria-label="Diagram illustrating bridge string spacing"><g fill="none" stroke="currentColor" stroke-width="1.4"><rect x="68" y="41" width="204" height="91" rx="5"/><path d="M98 31v112m29-112v112m29-112v112m29-112v112m29-112v112m29-112v112"/><path d="M98 151h145m-145-8v17m145-17v17"/><path d="m105 147-7 4 7 4m131-8 7 4-7 4"/></g><text x="170" y="175" text-anchor="middle">OUTER STRING SPACING (E-TO-E)</text></svg></div><span class="guide-type">MEASUREMENT GUIDE</span><h3>Measuring replacement parts <span>↗</span></h3></a><a class="guide-card" href="{{ guide_url }}"><div class="finishes-art"><span class="finish-sample chrome"></span><span class="finish-sample nickel"></span><span class="finish-sample black"></span><span class="finish-sample gold"></span></div><span class="guide-type">FINISH GUIDE</span><h3>Comparing hardware finishes <span>↗</span></h3></a></div></section>
<section class="closing-strip"><div class="wrap"><h2>Need help comparing parts?</h2><a class="button dark" href="{{ guide_url }}">Open the selection guide <svg class="icon"><use href="#i-arrow"/></svg></a></div></section>
{% schema %}
{"name":"FretFuel home","max_blocks":9,"settings":[{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"GUITAR & BASS REPLACEMENT PARTS"},{"type":"text","id":"hero_line_1","label":"Hero first line","default":"KEEP THE FEEL."},{"type":"text","id":"hero_line_2","label":"Hero second line","default":"FIND YOUR PART."},{"type":"textarea","id":"hero_description","label":"Hero description","default":"Tuners, bridges, pickups and replacement hardware.\nCompare shapes, dimensions and mounting details."},{"type":"image_picker","id":"hero_image","label":"Hero image override"},{"type":"url","id":"guide_url","label":"Parts guide page"},{"type":"text","id":"featured_title","label":"Featured heading","default":"Featured replacement parts."},{"type":"collection","id":"featured_collection","label":"Featured collection"},{"type":"text","id":"components_title","label":"Components heading","default":"Controls, pickguards & hardware."},{"type":"collection","id":"components_collection","label":"Components collection"},{"type":"collection","id":"hero_collection","label":"Hero series collection"},{"type":"collection","id":"stage_collection","label":"Stage series collection"},{"type":"collection","id":"black_collection","label":"BLACK series collection"},{"type":"collection","id":"black_x_collection","label":"BLACK X series collection"}],"blocks":[{"type":"category","name":"Part category","settings":[{"type":"text","id":"title","label":"Title","default":"Guitar parts"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Category image override"},{"type":"range","id":"atlas_index","label":"Illustration index","min":0,"max":8,"step":1,"default":0}]}],"presets":[{"name":"FretFuel home"}]}
{% endschema %}
