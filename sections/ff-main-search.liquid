<section class="wrap catalog-view"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Search</span></nav><div class="section-heading"><div><p class="eyebrow">FIND A REPLACEMENT PART</p><h1>Search parts.</h1></div></div><form class="ff-search-page-form" action="{{ routes.search_url }}" method="get"><input type="hidden" name="type" value="product"><label class="sr-only" for="SearchPageInput">Search products</label><input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search by part name or reference" required><button class="button yellow" type="submit">Search <svg class="icon"><use href="#i-search"/></svg></button></form>
  {% if search.performed %}{% paginate search.results by 24 %}<div class="results-top"><p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p></div><div class="product-grid catalog-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'ff-product-card', product: result %}{% endif %}{% else %}<div class="empty-state"><h2>No parts found.</h2><p>Try a different product name or reference.</p></div>{% endfor %}</div>{% render 'ff-pagination', paginate: paginate %}{% endpaginate %}{% endif %}
</section>
{% schema %}{"name":"FretFuel search","settings":[]}{% endschema %}
