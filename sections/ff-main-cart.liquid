<section class="wrap ff-cart-page"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Your bag</span></nav><p class="eyebrow">YOUR SELECTION</p><h1>Your bag</h1>
  {% if cart.item_count == 0 %}<div class="empty-state"><h2>Your bag is empty.</h2><p>Browse replacement parts and choose the right fit for your instrument.</p><a class="button dark" href="{{ routes.all_products_collection_url }}">Browse all parts</a></div>
  {% else %}<form action="{{ routes.cart_url }}" method="post" novalidate>
    <div class="ff-cart-items">{% for item in cart.items %}<div class="ff-cart-item"><a class="ff-cart-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><a class="product-name" href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<p>{{ item.final_price | money }} each</p><a class="ff-remove" href="{{ item.url_to_remove }}">Remove</a></div><label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="99" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}"></label><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div>
    <div class="ff-cart-summary"><button class="text-link" type="submit" name="update">Update bag</button><div class="ff-cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Shipping and taxes are calculated at checkout.</p><button class="button yellow" type="submit" name="checkout">Checkout <svg class="icon"><use href="#i-arrow"/></svg></button></div>
  </form>{% endif %}
</section>
{% schema %}{"name":"FretFuel cart","settings":[]}{% endschema %}
