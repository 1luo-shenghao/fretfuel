<section class="wrap catalog-view">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ collection.title | escape }}</span></nav>
  <div class="section-heading"><div><p class="eyebrow">THE FRETFUEL PARTS COLLECTION</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="catalog-subtitle rte">{{ collection.description }}</div>{% else %}<p class="catalog-subtitle">Compare shapes, dimensions and mounting details before you choose.</p>{% endif %}</div></div>
  {% paginate collection.products by 24 %}
    <form class="catalog-filters ff-collection-filters" action="{{ collection.url }}" method="get">
      {% for filter in collection.filters %}{% if filter.type == 'list' and forloop.index <= 4 %}
        <label>{{ filter.label | escape }}<select name="{{ filter.param_name }}"><option value="">All</option>{% for value in filter.values %}<option value="{{ value.value | escape }}"{% if value.active %} selected{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</option>{% endfor %}</select></label>
      {% endif %}{% endfor %}
      <label>Sort by<select name="sort_by">{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label>
      <button class="button dark" type="submit">Apply filters</button>
    </form>
    <div class="results-top"><p>{{ collection.products_count }} parts</p><a class="text-link" href="{{ collection.url }}">Clear filters ↗</a></div>
    <div class="product-grid catalog-grid">{% for product in collection.products %}{% render 'ff-product-card', product: product %}{% else %}<div class="empty-state"><h2>No parts found.</h2><p>Try another filter or browse the full collection.</p><a class="button dark" href="{{ collection.url }}">View all parts</a></div>{% endfor %}</div>
    {% render 'ff-pagination', paginate: paginate %}
  {% endpaginate %}
</section>
{% schema %}{"name":"FretFuel collection","settings":[]}{% endschema %}
