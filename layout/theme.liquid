<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0b0c">
    <link rel="icon" href="{{ 'ff-favicon.svg' | asset_url }}" type="image/svg+xml">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}
    {{ 'fretfuel.css' | asset_url | stylesheet_tag }}
    {{ 'fretfuel-theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'fretfuel-theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    {% render 'ff-icons' %}
    <a class="skip-link" href="#main">Skip to content</a>
    {% section 'ff-header' %}
    <main id="main">{{ content_for_layout }}</main>
    {% section 'ff-footer' %}
  </body>
</html>
